  "item": [
    {
      "id": "baa8da30-9841-4ac3-bdb8-5d0186dbe02c",
      "name": "sarif",
      "description": {
        "content": "The integration endpoints for generating and downloading SARIF reports for applications.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4a979711-6fd7-4859-b405-25083831db8b",
          "name": "Download Compound SARIF Report",
          "request": {
            "name": "Download Compound SARIF Report",
            "description": {
              "content": "Downloads the SARIF report for the specified compound.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":orgID",
                "compounds",
                "named",
                ":compoundName",
                "reports",
                "sarif"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "polyglot_scan",
                  "value": "<string>",
                  "description": "Polyglot scan ID to filter to; defaults to the latest scan."
                },
                {
                  "disabled": false,
                  "key": "scan_version",
                  "value": "<string>",
                  "description": "The version of the code at scan time. Ignored if polyglot_scan is given."
                },
                {
                  "disabled": false,
                  "key": "scan_branch",
                  "value": "<string>",
                  "description": "The code branch at scan time. Ignored if polygot_scan or scan_version are given."
                },
                {
                  "disabled": false,
                  "key": "scan_tag",
                  "value": "<string>",
                  "description": "Tags passed to the analyzer at scan time. Ignored if polygot_scan, scan_version, or scan_branch are given."
                },
                {
                  "disabled": false,
                  "key": "scan_platform",
                  "value": "<string>",
                  "description": "The analysis platform. Cannot be specified together with scan_language."
                },
                {
                  "disabled": false,
                  "key": "scan_language",
                  "value": "<string>",
                  "description": "The analysis language. Cannot be specified together with scan_platform."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "orgID",
                  "description": "(Required) The org ID"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "compoundName",
                  "description": "(Required) A compound's name"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/sarif+json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
