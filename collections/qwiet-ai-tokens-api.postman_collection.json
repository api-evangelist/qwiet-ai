        {
          "id": "a4d8c12e-bec7-4743-be31-c5a528e21365",
          "name": "List tokens",
          "request": {
            "name": "List tokens",
            "description": {
              "content": "Return a list of tokens issued by the org.\n\nThe token data returned includes metadata that identifies a token, included permissions, and an ID you can use to delete/revoke the token. The token data does NOT return the token value, which is exposed only when Qwiet issues the token.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":orgID",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "show_expired",
                  "value": "<boolean>",
                  "description": "Whether expired tokens should be returned or not"
                },
                {
                  "disabled": false,
                  "key": "token_type",
                  "value": "<string>",
                  "description": "Filter the response by the type of token"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "orgID",
                  "description": "(Required) The org ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
